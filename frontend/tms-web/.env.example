# eTMS by EBIM - plantilla de entorno del frontend.
# Copia a `.env.local` (ignorado por git) y rellena los valores locales.
# Solo las variables VITE_* llegan al bundle del navegador. Nunca pongas aquí una
# service-role key, una URL de base de datos ni ningún secreto de servidor.

# Backend de eTMS. Todos los datos de negocio pasan por Spring Boot, nunca directo a Supabase.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Supabase Auth - solo autenticación en V1 (login, refresh, logout).
# La anon/publishable key está diseñada para ser pública; la service-role key no, y
# no debe aparecer nunca en este archivo.
VITE_SUPABASE_URL=https://REPLACE-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=REPLACE-WITH-SUPABASE-ANON-KEY

# Mapas (Leaflet + OpenStreetMap). Las tres variables tienen valores por defecto que YA
# FUNCIONAN sin configurar nada: el selector de ubicación no necesita ninguna clave.
#
# Las teselas y el geocodificador públicos de openstreetmap.org son cortesía de la fundación y
# su política de uso desaconseja apoyarse en ellos para tráfico de producción. Para un
# despliegue con volumen, apunta estas variables a tu propio servidor o a un proveedor
# contratado. La atribución es obligatoria (ODbL) y cambia con el proveedor.
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
VITE_GEOCODER_URL=

# Google Maps JavaScript API - ya NO la usa el selector de ubicación, que va sobre Leaflet.
# Sigue alimentando los mapas de paradas de Planificación y Viajes.
# Una browser key es visible para cualquiera que abra las dev tools, así que DEBE
# restringirse en Google Cloud Console a los referrers HTTP de tu app y a las APIs que
# realmente se usan: "Maps JavaScript API". Déjala vacía para trabajar sin clave: esos mapas
# degradan a un aviso, y el selector de ubicación funciona igual porque ya no depende de ella.
VITE_GOOGLE_MAPS_API_KEY=

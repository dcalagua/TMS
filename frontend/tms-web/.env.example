# eTMS by EBIM - plantilla de entorno del frontend.
# Copia a `.env.local` (ignorado por git) y rellena los valores locales.
# Solo las variables VITE_* llegan al bundle del navegador. Nunca pongas aquí una
# service-role key, una URL de base de datos ni ningún secreto de servidor.

# Backend de eTMS. Todos los datos de negocio pasan por Spring Boot, nunca directo a Supabase.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Supabase Auth - solo autenticación en V1 (login, refresh, logout).
# La anon/publishable key está diseñada para ser pública; la service-role key no, y
# no debe aparecer nunca en este archivo.
VITE_SUPABASE_URL=https://REPLACE-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=REPLACE-WITH-SUPABASE-ANON-KEY

# Google Maps JavaScript API - solo el selector de ubicación y los mapas de paradas.
# Una browser key es visible para cualquiera que abra las dev tools, así que DEBE
# restringirse en Google Cloud Console a los referrers HTTP de tu app y a las APIs que
# realmente se usan: "Maps JavaScript API" y "Geocoding API". Déjala vacía para trabajar
# sin clave: el drawer de ubicación degrada a latitud/longitud manual en vez de fallar.
VITE_GOOGLE_MAPS_API_KEY=

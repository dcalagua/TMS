# TMS by EBIM - frontend environment template.
# Copy to `.env.local` (git-ignored) and fill in local values.
# Only VITE_* variables reach the browser bundle. Never put a service-role key,
# a database URL or any server secret in this file.

# TMS backend. All business data goes through Spring Boot, never straight to Supabase.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Supabase Auth - authentication only in V1 (sign in, refresh, sign out).
# The anon/publishable key is designed to be public; the service-role key is not and
# must never appear here.
VITE_SUPABASE_URL=https://REPLACE-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=REPLACE-WITH-SUPABASE-ANON-KEY

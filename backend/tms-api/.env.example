# TMS by EBIM - backend environment template.
# Copy to `.env` (git-ignored) and fill in local values. Placeholders only in this file.
# Never commit real credentials, service-role keys or remote database URLs.

# --- Runtime -----------------------------------------------------------------
SPRING_PROFILES_ACTIVE=local
TMS_API_PORT=8080

# --- Database ----------------------------------------------------------------
# Local Supabase stack (`supabase start`) listens on 54322. Local containers only.
#
# On the `local` profile the application refuses to run Flyway against a host that
# is not this machine (LocalProfileDatabaseGuard). That is a real refusal, not a
# warning: pointing TMS_DB_URL at a hosted project and starting the app would
# otherwise create the whole schema there without asking. See
# docs/development/DATABASE_SAFETY.md.
TMS_DB_URL=jdbc:postgresql://localhost:54322/postgres
TMS_DB_USERNAME=postgres
TMS_DB_PASSWORD=replace-with-local-password
TMS_DB_POOL_MAX=10
TMS_FLYWAY_ENABLED=true
# Deliberately absent, and left commented out so setting it is always a decision:
# it is the one switch that lets the local profile migrate a database somewhere
# else. Set it for a single command, never in a file that survives the session.
# TMS_ALLOW_REMOTE_DB=true

# --- Supabase Auth (JWT resource server) --------------------------------------
# The backend only needs the issuer/JWKS to verify tokens. It never needs the
# service-role key and there is no JWT signing secret setting: signatures are
# checked against the public keys Supabase publishes. Do not add a secret here.
#
# Both variables are mandatory. Leaving them unset does not start an unsecured
# API - the application refuses to start at all.
#
# Local stack (`supabase start`) defaults, already applied by the `local` profile:
#   http://127.0.0.1:54321/auth/v1
#   http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
TMS_SUPABASE_JWT_ISSUER_URI=https://REPLACE-PROJECT-REF.supabase.co/auth/v1
TMS_SUPABASE_JWKS_URI=https://REPLACE-PROJECT-REF.supabase.co/auth/v1/.well-known/jwks.json
# Accepted `aud` values, comma separated. Supabase issues `authenticated`.
TMS_SUPABASE_JWT_AUDIENCES=authenticated

# --- CORS ---------------------------------------------------------------------
# Exact origins, comma separated. Empty means no cross-origin browser call is
# allowed. Wildcards are rejected at startup.
TMS_CORS_ALLOWED_ORIGINS=http://localhost:5173

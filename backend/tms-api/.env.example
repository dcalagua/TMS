# TMS by EBIM - backend environment template.
# Copy to `.env` (git-ignored) and fill in local values. Placeholders only in this file.
# Never commit real credentials, service-role keys or remote database URLs.
#
# THIS FILE DESCRIBES THE **LOCAL** ENVIRONMENT AND NOTHING ELSE.
#
#   LOCAL  profile `local`, database on this machine, this file
#   QAS    profile `prod`,  hosted Supabase, values set in the Render dashboard
#   PROD   profile `prod`,  not provisioned yet - and it will be a *different* project
#
# A `.env` pointing at the hosted QAS project has been found in the working tree three
# times. Each time it was one distracted `java -jar` away from Flyway building the whole
# schema in an environment somebody else was using. If you need to work against QAS,
# do it with the deployed backend, not by repointing this file.
#
# See docs/environments/QAS.md and docs/development/DATABASE_SAFETY.md.

# --- Runtime -----------------------------------------------------------------
SPRING_PROFILES_ACTIVE=local
TMS_API_PORT=8080

# --- Database ----------------------------------------------------------------
# Local Supabase stack (`supabase start`) listens on 54322. Local containers only.
#
# On the `local` profile the application refuses to run Flyway against a host that
# is not this machine (LocalProfileDatabaseGuard). That is a real refusal, not a
# warning: pointing TMS_DB_URL at a hosted project and starting the app would
# otherwise create the whole schema there without asking. See
# docs/development/DATABASE_SAFETY.md.
TMS_DB_URL=jdbc:postgresql://localhost:54322/postgres
TMS_DB_USERNAME=postgres
TMS_DB_PASSWORD=replace-with-local-password
TMS_DB_POOL_MAX=10
TMS_FLYWAY_ENABLED=true
# Deliberately absent, and left commented out so setting it is always a decision:
# it is the one switch that lets the local profile migrate a database somewhere
# else. Set it for a single command, never in a file that survives the session.
# TMS_ALLOW_REMOTE_DB=true

# --- Supabase Auth (JWT resource server) --------------------------------------
# The backend only needs the issuer/JWKS to verify tokens. It never needs the
# service-role key and there is no JWT signing secret setting: signatures are
# checked against the public keys Supabase publishes. Do not add a secret here.
#
# Both variables are mandatory. Leaving them unset does not start an unsecured
# API - the application refuses to start at all.
#
# The local stack (`supabase start`) is the default here on purpose. Naming a hosted
# project in this file is how local work ends up authenticating - and then migrating -
# against a shared environment.
TMS_SUPABASE_JWT_ISSUER_URI=http://127.0.0.1:54321/auth/v1
TMS_SUPABASE_JWKS_URI=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
# Accepted `aud` values, comma separated. Supabase issues `authenticated`.
TMS_SUPABASE_JWT_AUDIENCES=authenticated

# --- CORS ---------------------------------------------------------------------
# Exact origins, comma separated. Empty means no cross-origin browser call is
# allowed. Wildcards are rejected at startup.
TMS_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- EBIM MasterAdmin provisioning (M2M) ---------------------------------------
# OFF unless deliberately enabled. When enabled, TMS verifies MasterAdmin's ES256
# tokens with its PUBLIC key only; the private key never comes near this backend
# (a PEM containing "PRIVATE KEY" is refused at startup). Put the real value in
# the deployment's secret store, not in this file.
# See docs/platform-provisioning/MASTERADMIN_GENERIC_CONTRACT.md.
TMS_PLATFORM_M2M_ENABLED=false
TMS_PLATFORM_M2M_PUBLIC_KEY=
# Defaults shown; override only if MasterAdmin's integration says otherwise.
# TMS_PLATFORM_M2M_ISSUER=masteradmin.ebim
# TMS_PLATFORM_M2M_AUDIENCE=tms.ebim
# TMS_PLATFORM_M2M_SUBJECT=masteradmin-provisioning
# TMS_PLATFORM_M2M_MAX_TOKEN_LIFETIME=300s

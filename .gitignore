# TMS by EBIM - repository ignore rules.
# Rule of thumb: ignore build output and local secrets, never source or *.example config.

# ---------------------------------------------------------------- Java / Maven
target/
!**/src/main/**/target/
!**/src/test/**/target/
*.class
*.jar
!**/.mvn/wrapper/maven-wrapper.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar.lastUpdated

# ------------------------------------------------------------- Node / frontend
node_modules/
dist/
dist-ssr/
build/
.vite/
coverage/
*.tsbuildinfo
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/

# ----------------------------------------------------------------- Local env &
# secrets. `.env.example` files are tracked on purpose; real env files are not.
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.p12
*.jks
!src/test/resources/**/*.jks
secrets.json
credentials.json

# -------------------------------------------------------------------- Supabase
# Local Supabase runtime state. `supabase/config.toml` IS tracked.
supabase/.branches/
supabase/.temp/
supabase/logs/
supabase/seed.local.sql

# ------------------------------------------------------------------------- IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.settings/
.project
.classpath
.factorypath
nbproject/private/
*.sublime-workspace

# -------------------------------------------------------------------------- OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ------------------------------------------------------------------------ Misc
*.log
logs/
tmp/
.tmp/
*.pid
.attach_pid*

# ------------------------------------------------------- Overnight prompt packs
# The generator packs are working material for a session, not part of the product,
# and CLAUDE.md says not to stage them. Named here so that is enforced rather than
# remembered - `git add -A` should never sweep them in.
tms-overnight-sellable-v4/
TMS-by-EBIM-Overnight-Sellable-v4*.zip
